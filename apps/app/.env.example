# Copia este fichero a .env (no se sube al repositorio).
# Valores que imprime `npx supabase start` (o `npx supabase status`):
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Clave PUBLICABLE (anon / sb_publishable_…). Nunca la secreta: la app se niega a arrancar con ella.
EXPO_PUBLIC_SUPABASE_KEY=pega-aqui-la-clave-publicable

# Para probar desde el iPhone en tu red local, usa la IP de tu ordenador en lugar de 127.0.0.1:
# EXPO_PUBLIC_SUPABASE_URL=http://192.168.1.50:54321
