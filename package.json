{
  "name": "organio",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:db": "scripts/test-db.sh",
    "test:api": "scripts/test-api.sh",
    "test:e2e": "scripts/test-e2e-web.sh",
    "postinstall": "node scripts/generate-icons.mjs",
    "start": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/windows/organio.ps1"
  },
  "engines": {
    "node": ">=22"
  },
  "overrides": {
    "react-native": "0.86.3",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "jsdom": "^26.1.0",
    "supabase": "2.117.0"
  }
}
